# clang-tidy checks for Iridium's hand-written C (src/c/).
# Generated C from valac is deliberately out of scope.
Checks: >-
  -*,
  bugprone-*,
  clang-analyzer-*,
  misc-definitions-in-headers,
  readability-braces-around-statements
WarningsAsErrors: false
HeaderFilterRegex: 'src/c/.*'
CheckOptions:
  - key: readability-braces-around-statements.ShortStatementLines
    value: 1
